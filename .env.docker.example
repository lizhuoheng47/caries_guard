# CariesGuard single full-chain runtime configuration.
# Copy this file to .env only when you need to override a port, secret, or device.

# Database
CARIES_MYSQL_PASSWORD=1234
CARIES_MYSQL_DATABASE_BIZ=caries_biz
CARIES_MYSQL_DATABASE_AI=caries_ai
CARIES_MYSQL_HOST_PORT=13306
CARIES_FLYWAY_CLEAN_ON_VALIDATION_ERROR=false
CARIES_FLYWAY_CLEAN_DISABLED=true

# Cache and message queue
CARIES_REDIS_HOST_PORT=16379
CARIES_RABBIT_USERNAME=guest
CARIES_RABBIT_PASSWORD=guest
CARIES_RABBIT_HOST_PORT=5672
CARIES_RABBIT_MGMT_HOST_PORT=15672

# Object storage
CARIES_MINIO_ACCESS_KEY=minioadmin
CARIES_MINIO_SECRET_KEY=minioadmin
CARIES_MINIO_HOST_PORT=9000
CARIES_MINIO_CONSOLE_HOST_PORT=9001
CARIES_BUCKET_IMAGE=caries-image
CARIES_BUCKET_VISUAL=caries-visual
CARIES_BUCKET_REPORT=caries-report
CARIES_BUCKET_EXPORT=caries-export

# Application
CARIES_FRONTEND_HOST_PORT=5173
CARIES_BACKEND_JAVA_HOST_PORT=8080
CARIES_BACKEND_PYTHON_HOST_PORT=8001
CARIES_IMAGE_ACCESS_SECRET=change-this-image-access-secret
CARIES_ANALYSIS_CALLBACK_SECRET=change-this-analysis-callback-secret
CARIES_ANALYSIS_MODEL_VERSION=caries-full-chain-v1

# The single runtime uses the trained DC1000 TorchScript segmenter.
# RTX 4060 / Docker Desktop with WSL2 GPU support: cuda:0
CG_MODEL_DEVICE=cuda:0
CG_MODEL_CONFIDENCE_THRESHOLD=0.5
CG_UNCERTAINTY_REVIEW_THRESHOLD=0.35

# Optional SMTP password reset delivery
CARIES_PASSWORD_RESET_ENABLED=true
CARIES_PASSWORD_RESET_DELIVERY_MODE=LOCAL
CARIES_PASSWORD_RESET_DEV_CODE_ENABLED=true
CARIES_PASSWORD_RESET_MAIL_FROM=
