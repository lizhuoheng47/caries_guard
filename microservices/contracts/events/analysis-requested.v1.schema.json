{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cariesguard.local/contracts/events/analysis-requested.v1.schema.json",
  "title": "Analysis requested event body v1",
  "type": "object",
  "required": ["taskNo", "caseId", "patientId", "modelVersion", "images"],
  "properties": {
    "traceId": { "type": ["string", "null"], "maxLength": 128 },
    "taskNo": { "type": "string", "minLength": 1, "maxLength": 64 },
    "taskTypeCode": { "type": ["string", "null"], "maxLength": 64 },
    "caseId": { "type": "integer" },
    "caseNo": { "type": ["string", "null"], "maxLength": 64 },
    "patientId": { "type": "integer" },
    "orgId": { "type": ["integer", "null"] },
    "modelVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
    "images": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["imageId", "attachmentId"],
        "properties": {
          "imageId": { "type": "integer" },
          "attachmentId": { "type": "integer" },
          "imageTypeCode": { "type": ["string", "null"] },
          "bucketName": { "type": ["string", "null"] },
          "objectKey": { "type": ["string", "null"] },
          "storageProviderCode": { "type": ["string", "null"] },
          "attachmentMd5": { "type": ["string", "null"] },
          "accessUrl": { "type": ["string", "null"] },
          "accessExpireAt": { "type": ["integer", "null"] },
          "localStoragePath": { "type": ["string", "null"] }
        },
        "additionalProperties": true
      }
    },
    "patientProfile": {
      "type": ["object", "null"],
      "properties": {
        "age": { "type": ["integer", "null"], "minimum": 0, "maximum": 150 },
        "genderCode": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
